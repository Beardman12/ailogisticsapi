# App metadata
APP_NAME=Mini Program API
APP_VERSION=0.1.0

# Database
DATABASE_URL=sqlite:///./data/app.db

# Auth / JWT
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# AI service (optional)
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.openai.com/v1
COZE_STREAM_RUN_URL=https://hkq24jmpqq.coze.site/stream_run
COZE_TOKEN=your-coze-token
COZE_PROJECT_ID=xxx

# Chukou1 OpenAPI
CHUKOU_API_BASE_URL=https://openapi.chukou1.cn:82
CHUKOU_ACCESS_TOKEN=your-chukou-access-token
CHUKOU_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO

# wechat
WECHAT_APPID=11
WECHAT_APPSECRET=11
WECHAT_API_BASE_URL=11
WECHAT_API_TIMEOUT_SECONDS=11